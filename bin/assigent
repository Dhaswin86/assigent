#!/usr/bin/env python3
"""Assigent: a 5-agent assignment helper that runs inside Claude Code.

  assigent run           start Claude Code on your next assignment
  assigent view          open the viewer that shows a run
  assigent play          open the playground made for a run
  assigent status        list your runs, each agent's state and the score
  assigent doctor        check that everything is installed
  assigent preferences   optional: see or change the answers Assigent remembers
  assigent config        print the answers Assigent remembers
  assigent uninstall     remove Assigent (your assignment folders stay)

There is no setup to do. Assigent asks only what each assignment needs, and
remembers answers it can reuse (your name, your apps) in ~/.assigent/config.json.
Run "assigent <command> --help" for the options of one command.
Python 3 standard library only.
"""
import argparse, json, os, re, shutil, signal, socket, subprocess, sys, time
import urllib.request
from datetime import datetime

VERSION = "1.3.0"
INSTALL_URL = "https://raw.githubusercontent.com/Dhaswin86/assigent/main/install.sh"

# Exit codes
OK, FAILED, USAGE, NO_CLAUDE = 0, 1, 2, 3

HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(HOME, ".assigent")
CONFIG = os.path.join(CONFIG_DIR, "config.json")
VIEWER_STATE = os.path.join(CONFIG_DIR, "viewer.json")
AGENTS_DIR = os.path.join(HOME, ".claude", "agents")
SKILL_DIR = os.path.join(HOME, ".claude", "skills", "assigent")
CLI_PATH = os.path.join(HOME, ".local", "bin", "assigent")
AGENT_FILES = ["assigent-analyst.md", "assigent-finder.md", "assigent-researcher.md", "assigent-builder.md", "assigent-evaluator.md", "assigent-tutor.md"]
DEFAULT_FOLDER = "~/Documents/Assignments"
FIRST_PORT = 8850

PLATFORMS = [
    ("zoho-schools", "Zoho Schools"),
    ("google-classroom", "Google Classroom"),
    ("canvas", "Canvas"),
    ("moodle", "Moodle"),
    ("microsoft-teams", "Microsoft Teams"),
    ("other", "Other platform"),
    ("paste", "I'll paste the brief myself"),
]
BROWSERS = [("chrome", "Chrome"), ("brave", "Brave"), ("edge", "Edge"), ("none", "None")]
AI_HELP = [
    ("ask", "Ask me when an assignment states no AI rule"),
    ("full", "Full work: Assigent does the assignment"),
    ("coach", "Coach only: a plan and feedback, you do the work"),
    ("study", "Study sources only: a brief and reading list"),
]
APP_GROUPS = [
    ("slides", "Slides", [("powerpoint", "PowerPoint"), ("keynote", "Keynote"), ("google-slides", "Google Slides")]),
    ("sheets", "Sheets", [("excel", "Excel"), ("numbers", "Numbers"), ("google-sheets", "Google Sheets")]),
    ("documents", "Documents", [("word", "Word"), ("pages", "Pages"), ("google-docs", "Google Docs")]),
    ("design", "Design", [("photoshop", "Photoshop"), ("illustrator", "Illustrator"), ("figma", "Figma"), ("canva", "Canva")]),
]
ACCESS_NOTICE = ("Assigent will only read assignment pages in the browser you are signed in to. "
                 "It never signs in, never submits.")
DEFAULTS = {"version": 2, "name": "", "save_folder": "", "ai_help": "ask",
            "apps": {"slides": [], "sheets": [], "documents": [], "design": [], "other": []},
            "code_editor": "", "browser": "none", "browser_access": False, "platform": "", "portal_url": ""}
AGENT_ORDER = ["analyst", "finder", "builder", "evaluator"]


def say(msg=""):
    print(msg)


def fail(msg, code=FAILED):
    print(msg, file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------- config

def load_config():
    """Return (config, problem). A missing file is not a problem: it gives ({}, None).
    config is None only when the file exists and cannot be read."""
    if not os.path.isfile(CONFIG):
        return {}, None
    try:
        with open(CONFIG) as f:
            cfg = json.load(f)
    except (OSError, ValueError) as e:
        return None, f"not valid JSON ({e})"
    if not isinstance(cfg, dict):
        return None, "not a JSON object"
    return cfg, None


def config_problems(cfg):
    """Plain-language problems with saved preferences. Every field is optional, so only
    a value that is present and wrong counts. Empty list means fine."""
    out = []
    has = lambda k: cfg.get(k) not in (None, "")
    if has("name") and not isinstance(cfg["name"], str):
        out.append("name must be text")
    if has("save_folder") and not isinstance(cfg["save_folder"], str):
        out.append("save_folder must be text")
    if has("platform") and cfg["platform"] not in dict(PLATFORMS):
        out.append("platform is not one of: " + ", ".join(k for k, _ in PLATFORMS))
    if has("browser") and cfg["browser"] not in dict(BROWSERS):
        out.append("browser is not one of: chrome, brave, edge, none")
    if "browser_access" in cfg and not isinstance(cfg["browser_access"], bool):
        out.append("browser_access must be true or false")
    if has("ai_help") and cfg["ai_help"] not in dict(AI_HELP):
        out.append("ai_help is not one of: ask, full, coach, study")
    if "apps" in cfg and not isinstance(cfg["apps"], dict):
        out.append("apps must be an object")
    return out


def quiet_config():
    """Saved preferences, or {} when there are none or the file is unreadable (with a note)."""
    cfg, problem = load_config()
    if cfg is None:
        print(f"Note: ~/.assigent/config.json is {problem}. Using the defaults. "
              "Fix it with: assigent preferences", file=sys.stderr)
        return {}
    return cfg


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = CONFIG + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    os.replace(tmp, CONFIG)


def save_folder(cfg=None):
    root = os.environ.get("ASSIGENT_ROOT")
    if not root:
        if cfg is None:
            cfg, _ = load_config()
        root = (cfg or {}).get("save_folder")
        if not isinstance(root, str):
            root = None
    return os.path.abspath(os.path.expanduser(root or DEFAULT_FOLDER))


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", str(text).strip().lower()).strip("-")


def parse_apps(text):
    """Turn "powerpoint, Excel, word" into the grouped apps object. Unknown names go to "other"."""
    apps = {key: [] for key, _, _ in APP_GROUPS}
    apps["other"] = []
    known = {name: key for key, _, items in APP_GROUPS for name, _ in items}
    for raw in re.split(r"[,;]", text or ""):
        name = slug(raw)
        if not name or name == "none":
            continue
        group = known.get(name, "other")
        if name not in apps[group]:
            apps[group].append(name)
    return apps


def flat_apps(apps):
    out = []
    for key in [k for k, _, _ in APP_GROUPS] + ["other"]:
        out += (apps or {}).get(key, []) or []
    return out


def yes_no(text):
    t = str(text).strip().lower()
    if t in ("y", "yes", "true", "1"):
        return True
    if t in ("n", "no", "false", "0"):
        return False
    return None


# ---------------------------------------------------------------- preferences (optional)

def ask(prompt, default=""):
    hint = f" [{default}]" if default else ""
    try:
        answer = input(f"{prompt}{hint}: ").strip()
    except EOFError:
        fail("\nSetup stopped: no more input. Nothing was saved.", USAGE)
    return answer or default


def choose(title, options, default):
    say(title)
    for i, (key, label) in enumerate(options, 1):
        say(f"  {i}. {label}" + ("  (default)" if key == default else ""))
    keys = [k for k, _ in options]
    while True:
        a = ask("Type a number", str(keys.index(default) + 1)).lower()
        if a.isdigit() and 1 <= int(a) <= len(keys):
            return keys[int(a) - 1]
        if a in keys:
            return a
        say(f"Please type a number from 1 to {len(keys)}.")


def clean_url(url):
    url = (url or "").strip()
    if url and not re.match(r"^https?://", url, re.I):
        url = "https://" + url
    return url


def merge_apps(base, extra):
    out = {k: list((base or {}).get(k, []) or []) for k in [g for g, _, _ in APP_GROUPS] + ["other"]}
    for k, names in extra.items():
        out[k] += [n for n in names if n not in out[k]]
    return out


def cmd_preferences(a):
    """Optional. Nothing depends on it: it only pre-fills or changes what Assigent remembers."""
    old, problem = load_config()
    if old is None:
        say(f"Note: the old ~/.assigent/config.json was {problem}; starting fresh.")
        old = {}
    for flag, value in (("--app-permission", a.app_permission), ("--ask-choices", a.ask_choices)):
        if value is not None:
            say(f"Note: {flag} is no longer used and was ignored. Assigent now asks only what each assignment needs.")
    given = [a.name, a.folder, a.platform, a.portal_url, a.browser, a.browser_access, a.ai_help,
             a.apps, a.add_apps, a.code_editor]
    prompt = not a.yes and not a.reset
    if a.reset:
        if os.path.exists(CONFIG):
            os.remove(CONFIG)
        say("Forgot your saved answers. Assigent will ask again when an assignment needs them.")
        return OK
    if a.yes and all(g is None for g in given):
        say("Nothing to save: no answers were given. Example: assigent preferences --name \"Sam Lee\" --yes")
        return OK

    if prompt:
        say("Assigent preferences. All of this is optional.")
        say("Assigent asks what each assignment needs and remembers the answers here, so it")
        say("does not ask twice. Press Enter to skip a line or keep the value in [brackets].\n")

    # name
    name = a.name if a.name is not None else old.get("name", "")
    if prompt and a.name is None:
        name = ask("Your name, as it should appear on hand-ins", name)
    name = str(name).strip()

    # save folder
    folder = a.folder if a.folder is not None else old.get("save_folder", "")
    if prompt and a.folder is None:
        folder = ask("Where to save assignment folders", folder or DEFAULT_FOLDER)
    folder = os.path.abspath(os.path.expanduser(str(folder).strip())) if str(folder).strip() else ""

    # AI help when an assignment states no rule
    ai_help = a.ai_help or old.get("ai_help") or "ask"
    if prompt and not a.ai_help:
        say("")
        ai_help = choose("How much AI help when an assignment states no AI rule", AI_HELP,
                         ai_help if ai_help in dict(AI_HELP) else "ask")
    if ai_help not in dict(AI_HELP):
        fail("Unknown --ai-help. Choose one of: ask, full, coach, study", USAGE)

    # apps
    old_apps = old.get("apps") if isinstance(old.get("apps"), dict) else {}
    if a.apps is not None:
        apps = parse_apps(a.apps)
    elif prompt:
        say("\nApps you have, so files come out in a type you can open")
        apps = {"other": list(old_apps.get("other", []))}
        for key, label, items in APP_GROUPS:
            names = ", ".join(n for n, _ in items)
            got = ask(f"{label} ({names}). Type the ones you have, with commas, or leave empty",
                      ", ".join(old_apps.get(key, [])))
            picked = parse_apps(got)
            apps[key] = picked[key]
            apps["other"] += [x for k in picked for x in picked[k] if k != key and x not in apps["other"]]
    else:
        apps = merge_apps(old_apps, {})
    if a.add_apps is not None:
        apps = merge_apps(apps, parse_apps(a.add_apps))
    editor = a.code_editor if a.code_editor is not None else old.get("code_editor", "")
    if prompt and a.code_editor is None:
        editor = ask("Code editor (for example vscode), or leave empty", editor)
    editor = slug(editor) if slug(editor) != "none" else ""

    # browser, and permission to read a portal tab through it
    platform = a.platform or old.get("platform", "")
    if platform and platform not in dict(PLATFORMS):
        fail("Unknown platform. Choose one of: " + ", ".join(k for k, _ in PLATFORMS), USAGE)
    browser = a.browser or old.get("browser") or "none"
    if prompt and not a.browser:
        say("")
        browser = choose("Browser Assigent may read your assignments from (it needs the Claude browser extension)",
                         BROWSERS, browser if browser in dict(BROWSERS) else "none")
    if browser not in dict(BROWSERS):
        fail("Unknown browser. Choose one of: chrome, brave, edge, none", USAGE)
    access = False
    if browser != "none":
        if a.browser_access is not None:
            access = yes_no(a.browser_access)
            if access is None:
                fail("--browser-access takes yes or no.", USAGE)
        elif prompt:
            say("\n" + ACCESS_NOTICE)
            while True:
                access = yes_no(ask("Allow Assigent to read your portal through this browser? (yes/no)",
                                    "yes" if old.get("browser_access") and old.get("browser") == browser else "no"))
                if access is not None:
                    break
                say("Please type yes or no.")
        else:
            # Never assume permission: it only carries over for the same browser.
            access = bool(old.get("browser_access", False)) and old.get("browser") == browser
    portal = a.portal_url if a.portal_url is not None else old.get("portal_url", "")
    if prompt and a.portal_url is None and browser != "none":
        portal = ask("Web address of your portal's assignments page (leave empty to skip)", portal)
    portal = clean_url(portal)

    now = datetime.now().isoformat(timespec="seconds")
    cfg = {"version": 2, "name": name, "save_folder": folder, "ai_help": ai_help, "apps": apps,
           "code_editor": editor, "browser": browser, "browser_access": bool(access),
           "platform": platform, "portal_url": portal,
           "created": old.get("created", now), "updated": now}
    problems = config_problems(cfg)
    if problems:
        fail("Could not save: " + "; ".join(problems), USAGE)
    save_config(cfg)
    if folder:
        try:
            os.makedirs(folder, exist_ok=True)
        except OSError as e:
            say(f"Note: could not create {folder} ({e.strerror}). Create it yourself, or choose another folder.")

    say("\nSaved to ~/.assigent/config.json")
    print_summary(cfg)
    say("\nNext: assigent run")
    return OK


def print_summary(cfg):
    label = lambda pairs, key: dict(pairs).get(key, key)
    apps = flat_apps(cfg.get("apps") if isinstance(cfg.get("apps"), dict) else {}) + ([cfg["code_editor"]] if cfg.get("code_editor") else [])
    ai = cfg.get("ai_help") or "ask"
    rows = [
        ("Name", cfg.get("name") or "not saved (asked when a hand-in needs it)"),
        ("Save folder", cfg.get("save_folder") or f"{save_folder(cfg)} (the default)"),
        ("AI help, no rule", "asked per assignment" if ai == "ask" else ai),
        ("Apps", ", ".join(apps) or "none saved (asked when an assignment needs one)"),
        ("Browser", label(BROWSERS, cfg.get("browser") or "none")),
        ("May read the portal", "yes" if cfg.get("browser_access") else "no (asked if you choose the browser)"),
        ("Portal address", cfg.get("portal_url") or "none"),
    ]
    for k, v in rows:
        say(f"  {k + ':':<21}{v}")


# ---------------------------------------------------------------- config

def cmd_config(a):
    cfg, problem = load_config()
    if cfg is None:
        fail(f"~/.assigent/config.json is {problem}. Fix it with: assigent preferences  (or forget it: assigent preferences --reset)", FAILED)
    if a.json:
        say(json.dumps(cfg, indent=2))
        return OK
    if not cfg:
        say("No saved preferences yet. That is fine: Assigent asks what each assignment needs")
        say("and remembers the answers it can reuse. What it would use now:")
    else:
        say("What Assigent remembers (~/.assigent/config.json)")
    print_summary(cfg)
    problems = config_problems(cfg)
    if problems:
        say("\nProblems: " + "; ".join(problems) + ". Fix with: assigent preferences")
        return FAILED
    return OK


# ---------------------------------------------------------------- run

def cmd_run(a):
    cfg = quiet_config()
    root = save_folder(cfg)
    try:
        os.makedirs(root, exist_ok=True)
    except OSError as e:
        fail(f"Could not create the save folder {root} ({e.strerror}). Choose another: assigent preferences --folder <path> --yes", FAILED)
    prompt = "/assigent"
    if a.paste:
        path = os.path.abspath(os.path.expanduser(a.paste))
        if not os.path.isfile(path):
            fail(f"No brief file at {path}", USAGE)
        prompt = f"/assigent {path}"
    claude = shutil.which("claude")
    if not claude:
        fail("Claude Code is not installed, so Assigent cannot start.\n"
             "Get it from https://claude.com/claude-code (it needs a Claude plan that includes Claude Code),\n"
             "then run: assigent run", NO_CLAUDE)
    say(f"Starting Claude Code with {prompt}")
    sys.stdout.flush()
    os.execv(claude, [claude, prompt])


# ---------------------------------------------------------------- runs / status

def status_files(root, max_depth=4):
    found = []
    base = root.rstrip(os.sep).count(os.sep)
    for cur, dirs, names in os.walk(root):
        depth = cur.rstrip(os.sep).count(os.sep) - base
        dirs[:] = [] if depth >= max_depth else sorted(d for d in dirs if not d.startswith("."))
        if "status.json" in names:
            found.append(os.path.join(cur, "status.json"))
            dirs[:] = []
    return found


def read_score(folder):
    """(score, verdict) from evaluation.md, or (None, None)."""
    try:
        with open(os.path.join(folder, "evaluation.md"), errors="replace") as f:
            text = f.read(20000)
    except OSError:
        return None, None
    s = re.search(r"^Score:\s*(\d{1,3})\s*/\s*100", text, re.M)
    v = re.search(r"^Verdict:\s*(PASS|REVISE)\b", text, re.M)
    return (int(s.group(1)) if s else None), (v.group(1) if v else None)


def find_runs(root):
    runs = []
    for p in status_files(root):
        try:
            with open(p) as f:
                s = json.load(f)
            agents = {x["id"]: x.get("state", "?") for x in s.get("agents", [])}
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            continue
        folder = os.path.dirname(p)
        score, verdict = read_score(folder)
        pg = s.get("playground") if isinstance(s.get("playground"), dict) else {}
        has_play = os.path.isfile(os.path.join(folder, "playground", "index.html"))
        play = "being made" if pg.get("state") == "running" else "ready" if has_play else "skipped" if pg.get("state") == "skipped" else "none"
        runs.append({"playground": play, "folder": folder, "title": s.get("title") or os.path.basename(folder),
                     "aiPolicy": s.get("aiPolicy"), "updated": s.get("updated", ""),
                     "agents": agents, "score": score, "verdict": verdict})
    runs.sort(key=lambda r: r["updated"], reverse=True)
    return runs


def cmd_status(a):
    root = save_folder(quiet_config())
    runs = find_runs(root) if os.path.isdir(root) else []
    if a.json:
        say(json.dumps(runs, indent=2))
        return OK
    if not os.path.isdir(root):
        say(f"No runs yet. Your save folder ({root}) is created on the first run.")
        say("Start one with: assigent run")
        return OK
    if not runs:
        say(f"No runs yet in {root}")
        say("Start one with: assigent run")
        return OK
    say(f"{len(runs)} run{'s' if len(runs) != 1 else ''} in {root}\n")
    for r in runs:
        say(r["title"])
        say("  " + "   ".join(f"{k}: {r['agents'].get(k, 'not started')}" for k in AGENT_ORDER))
        if r["score"] is not None:
            say(f"  score: {r['score']}/100" + (f", {r['verdict']}" if r["verdict"] else ""))
        else:
            say("  score: not marked yet")
        say(f"  playground: {r['playground']}" + ("   (open it with: assigent play)" if r["playground"] == "ready" else ""))
        say(f"  AI policy: {r['aiPolicy'] or 'unknown'}   updated: {r['updated'] or 'unknown'}")
        say(f"  folder: {r['folder']}\n")
    return OK


# ---------------------------------------------------------------- play

def cmd_play(a):
    """Open a run's playground: on its own viewer page when the viewer is running, otherwise the file itself."""
    root = save_folder(quiet_config())
    runs = find_runs(root) if os.path.isdir(root) else []
    if not runs:
        fail("No runs yet, so there is no playground. Start one with: assigent run", FAILED)
    want = " ".join(a.run).strip()
    if not want:
        idx = next((i for i, r in enumerate(runs) if r["playground"] == "ready"), 0)
    elif want.isdigit():
        idx = int(want) - 1
        if not 0 <= idx < len(runs):
            fail(f"There is no run number {want}. \"assigent status\" lists {len(runs)}.", USAGE)
    else:
        idx = next((i for i, r in enumerate(runs) if want.lower() in str(r["title"]).lower()), None)
        if idx is None:
            fail(f"No run has \"{want}\" in its name. See them with: assigent status", USAGE)
    run = runs[idx]
    if run["playground"] != "ready":
        why = {"being made": "is still being made. Try again in a minute.", "skipped": "was skipped for this run."}.get(
            run["playground"], "has not been made yet. In Claude Code, say: /assigent make the playgrounds")
        fail(f"The playground for \"{run['title']}\" {why}", FAILED)
    path = os.path.join(run["folder"], "playground", "index.html")
    st = viewer_state()
    target = f"http://127.0.0.1:{st['port']}/playground.html?run={idx}" if st else "file://" + urllib.request.pathname2url(path)
    say(f"Playground for \"{run['title']}\"")
    say(target if st else path)
    if not a.no_open:
        try:
            import webbrowser
            webbrowser.open(target)
        except Exception:
            say("Open that in your browser.")
    return OK


# ---------------------------------------------------------------- view

def ui_dir():
    here = os.path.dirname(os.path.realpath(__file__))
    for d in (os.path.join(SKILL_DIR, "ui"), os.path.join(here, "..", "skill", "assigent", "ui")):
        if os.path.isfile(os.path.join(d, "server.py")):
            return os.path.abspath(d)
    return None


def port_free(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        try:
            s.bind(("127.0.0.1", port))
            return True
        except OSError:
            return False


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, TypeError):
        return False


def responds(port):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/runs", timeout=2) as r:
            return r.status == 200
    except Exception:
        return False


def viewer_state():
    try:
        with open(VIEWER_STATE) as f:
            st = json.load(f)
        if alive(st.get("pid")) and responds(st.get("port")):
            return st
    except (OSError, ValueError, AttributeError):
        pass
    return None


def stop_viewer():
    st = viewer_state()
    if os.path.exists(VIEWER_STATE):
        os.remove(VIEWER_STATE)
    if not st:
        return False
    try:
        os.kill(st["pid"], signal.SIGTERM)
    except OSError:
        return False
    for _ in range(30):
        if not alive(st["pid"]):
            break
        time.sleep(0.1)
    return True


def cmd_view(a):
    if a.stop:
        say("Viewer stopped." if stop_viewer() else "The viewer was not running.")
        return OK
    ui = ui_dir()
    if not ui:
        fail("The viewer files are missing. Run the installer again, then: assigent doctor", FAILED)
    st = viewer_state()
    if st and not a.foreground:
        url = f"http://127.0.0.1:{st['port']}/"
        say(f"The viewer is already running at {url}")
    else:
        port = a.port or next((p for p in range(FIRST_PORT, FIRST_PORT + 100) if port_free(p)), None)
        if not port or not port_free(port):
            fail("Could not find a free port for the viewer. Close another viewer and try again.", FAILED)
        env = dict(os.environ, PORT=str(port))
        cmd = [sys.executable, os.path.join(ui, "server.py")]
        url = f"http://127.0.0.1:{port}/"
        if a.foreground:
            say(f"Viewer running at {url}  (press Ctrl+C to stop)")
            sys.stdout.flush()
            try:
                return subprocess.call(cmd, env=env)
            except KeyboardInterrupt:
                return OK
        os.makedirs(CONFIG_DIR, exist_ok=True)
        log = open(os.path.join(CONFIG_DIR, "viewer.log"), "ab")
        proc = subprocess.Popen(cmd, env=env, stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                start_new_session=True)
        for _ in range(50):
            if responds(port) or proc.poll() is not None:
                break
            time.sleep(0.1)
        if proc.poll() is not None or not responds(port):
            fail("The viewer did not start. See ~/.assigent/viewer.log", FAILED)
        with open(VIEWER_STATE, "w") as f:
            json.dump({"pid": proc.pid, "port": port, "started": datetime.now().isoformat(timespec="seconds")}, f)
        say(f"Viewer running at {url}")
        say(f"It shows the runs in {save_folder(quiet_config())}")
        say("Stop it with: assigent view --stop")
    if not a.no_open:
        try:
            import webbrowser
            webbrowser.open(url)
        except Exception:
            say("Open that address in your browser.")
    return OK


# ---------------------------------------------------------------- doctor

def cmd_doctor(a):
    results = []

    def check(name, ok, detail, fix=""):
        results.append(ok)
        say(f"{'ok   ' if ok else 'FIX  '}{name}: {detail}" + ("" if ok or not fix else f"\n       Fix: {fix}"))

    v = sys.version_info
    check("Python 3", v >= (3, 8), f"{v.major}.{v.minor}.{v.micro}", "Install Python 3.8 or newer from python.org")

    claude = shutil.which("claude")
    check("Claude Code", bool(claude), claude or "the claude command was not found",
          "Install it from https://claude.com/claude-code and sign in with your Claude plan")

    cfg, problem = load_config()
    if cfg is None:
        check("Preferences", False, f"~/.assigent/config.json is {problem}",
              "Run: assigent preferences --reset  (Assigent then asks again when it needs an answer)")
        cfg = {}
    elif not cfg:
        check("Preferences", True, "no saved preferences yet (that is fine, Assigent asks when it needs something)")
    else:
        problems = config_problems(cfg)
        check("Preferences", not problems, "; ".join(problems) or "~/.assigent/config.json is readable",
              "Run: assigent preferences")

    missing = [f for f in AGENT_FILES if not os.path.isfile(os.path.join(AGENTS_DIR, f))]
    check("Agents", not missing, "missing " + ", ".join(missing) if missing else "6 agents in ~/.claude/agents",
          "Run the installer again (./install.sh)")

    skill_ok = all(os.path.isfile(os.path.join(SKILL_DIR, p)) for p in
                   ("SKILL.md", "preferences.md", os.path.join("ui", "server.py"), os.path.join("ui", "status.py")))
    check("Skill", skill_ok, "~/.claude/skills/assigent is complete" if skill_ok else "files are missing from ~/.claude/skills/assigent",
          "Run the installer again (./install.sh)")

    play_ok = (os.path.isfile(os.path.join(AGENTS_DIR, "assigent-tutor.md"))
               and all(os.path.isfile(os.path.join(SKILL_DIR, "ui", f)) for f in ("playground.html", "playground.js")))
    check("Playground", play_ok, "the Tutor and the playground page are installed" if play_ok
          else "this install is older than the playground", "Run: assigent update")

    root = save_folder(cfg)
    parent = root
    while not os.path.exists(parent) and os.path.dirname(parent) != parent:
        parent = os.path.dirname(parent)
    can_make = os.path.isdir(root) or os.access(parent, os.W_OK)
    check("Save folder", can_make, root if os.path.isdir(root) else (f"{root} (created on the first run)" if can_make else f"{root} cannot be created"),
          "Choose another: assigent preferences --folder <path> --yes")

    bad = results.count(False)
    say("")
    say("Everything is ready. Start with: assigent run" if not bad
        else f"{bad} thing{'s' if bad != 1 else ''} to fix. Follow the Fix lines above, then run: assigent doctor")
    return OK if not bad else FAILED


# ---------------------------------------------------------------- uninstall

def cmd_update(a):
    """Get the newest Assigent: download the installer and run it again. Saved answers and assignment folders stay."""
    if not shutil.which("curl") or not shutil.which("bash"):
        fail("Updating needs curl and bash. Or download the newest copy from github.com/Dhaswin86/assigent and run ./install.sh", FAILED)
    say(f"Assigent {VERSION} is installed. Getting the newest one...")
    rc = subprocess.call(["bash", "-c", f"set -o pipefail; curl -fsSL {INSTALL_URL} | bash"])
    if rc != 0:
        fail("The update did not finish. Check your internet connection and try again.", FAILED)
    say("Updated. Close Claude Code and open it again so it sees the new agents.")
    say("Then, for assignments that have no playground yet, say: /assigent make the playgrounds")
    return OK


def cmd_uninstall(a):
    targets = [os.path.join(AGENTS_DIR, f) for f in AGENT_FILES] + [SKILL_DIR, CLI_PATH]
    present = [t for t in targets if os.path.lexists(t)]
    interactive = sys.stdin.isatty()
    if not a.yes:
        if not interactive:
            fail("Uninstall needs a yes. Run it in a terminal, or add --yes.", USAGE)
        say("This removes the Assigent agents, skill and command:")
        for t in present:
            say("  " + t)
        say("Your assignment folders are not touched.")
        if yes_no(ask("Remove them? (yes/no)", "no")) is not True:
            say("Nothing was removed.")
            return OK
    stop_viewer()
    for t in present:
        if os.path.isdir(t) and not os.path.islink(t):
            shutil.rmtree(t)
        else:
            os.remove(t)
        say(f"Removed {t}")
    if not present:
        say("Assigent was not installed here. Nothing to remove.")

    if os.path.isdir(CONFIG_DIR):
        drop = a.delete_config
        if not drop and interactive and not a.keep_config:
            drop = yes_no(ask("Also delete your saved answers in ~/.assigent? (yes/no)", "no")) is True
        if drop:
            shutil.rmtree(CONFIG_DIR)
            say("Removed ~/.assigent")
        else:
            say("Kept your saved answers in ~/.assigent (delete them with: assigent uninstall --delete-config, or remove the folder)")
    say("Your assignment folders were left alone.")
    return OK


# ---------------------------------------------------------------- main

def main(argv=None):
    p = argparse.ArgumentParser(prog="assigent", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"assigent {VERSION}")
    sub = p.add_subparsers(dest="cmd", metavar="<command>")

    for cmd_name in ("preferences", "setup"):
        shown = {"help": "optional: see or change the answers Assigent remembers"} if cmd_name == "preferences" else {}
        s = sub.add_parser(cmd_name, **shown,
                           description="Optional. Assigent works without it: it asks what each assignment needs and remembers "
                                       "reusable answers by itself. Use this to pre-fill or change them. Every answer can be a "
                                       "flag; add --yes to skip the prompts. (\"setup\" is the old name of this command.)")
        s.add_argument("--name", help="your name, as it should appear on hand-ins")
        s.add_argument("--folder", help=f"where to save assignment folders (default {DEFAULT_FOLDER})")
        s.add_argument("--ai-help", type=slug, help="ask, full, coach or study: what to do when an assignment states no AI rule")
        s.add_argument("--apps", help='apps you have, with commas, e.g. "powerpoint,excel,word,figma" (replaces the saved list)')
        s.add_argument("--add-apps", help="apps to add to the saved list, with commas")
        s.add_argument("--code-editor", help="your code editor, e.g. vscode")
        s.add_argument("--browser", type=slug, help="chrome, brave, edge or none")
        s.add_argument("--browser-access", metavar="yes|no", help="may Assigent read your portal through that browser")
        s.add_argument("--portal-url", help="web address of your portal's assignments page")
        s.add_argument("--platform", type=slug, help="optional note of your platform: " + ", ".join(k for k, _ in PLATFORMS))
        s.add_argument("--app-permission", help=argparse.SUPPRESS)   # old flag: accepted, ignored
        s.add_argument("--ask-choices", help=argparse.SUPPRESS)      # old flag: accepted, ignored
        s.add_argument("--reset", action="store_true", help="forget every saved answer")
        s.add_argument("--yes", "-y", action="store_true", help="do not prompt; save the flags over what is remembered")
        s.set_defaults(fn=cmd_preferences)

    s = sub.add_parser("run", help="start Claude Code on your next assignment")
    s.add_argument("--paste", metavar="FILE", help="a file that holds the assignment brief")
    s.set_defaults(fn=cmd_run)

    s = sub.add_parser("view", help="open the viewer that shows a run")
    s.add_argument("--port", type=int, help=f"port to use (default: the first free one from {FIRST_PORT})")
    s.add_argument("--no-open", action="store_true", help="do not open the browser")
    s.add_argument("--foreground", action="store_true", help="keep running in this terminal until Ctrl+C")
    s.add_argument("--stop", action="store_true", help="stop the viewer")
    s.set_defaults(fn=cmd_view)

    s = sub.add_parser("play", help="open the playground made for a run",
                       description="Open a run's playground. With no name it opens the newest run that has one.")
    s.add_argument("run", nargs="*", help="a run number from \"assigent status\", or part of its name")
    s.add_argument("--no-open", action="store_true", help="print where it is, do not open the browser")
    s.set_defaults(fn=cmd_play)

    s = sub.add_parser("status", help="list your runs, each agent's state and the score")
    s.add_argument("--json", action="store_true", help="print as JSON")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("doctor", help="check that everything is installed")
    s.set_defaults(fn=cmd_doctor)

    s = sub.add_parser("update", help="get the newest Assigent (your answers and folders stay)")
    s.set_defaults(fn=cmd_update)

    s = sub.add_parser("config", help="print the answers Assigent remembers")
    s.add_argument("--json", action="store_true", help="print the raw file")
    s.set_defaults(fn=cmd_config)

    s = sub.add_parser("uninstall", help="remove Assigent (your assignment folders stay)")
    s.add_argument("--yes", "-y", action="store_true", help="do not ask before removing the agents, skill and command")
    s.add_argument("--delete-config", action="store_true", help="also delete ~/.assigent without asking")
    s.add_argument("--keep-config", action="store_true", help="keep ~/.assigent without asking")
    s.set_defaults(fn=cmd_uninstall)

    a = p.parse_args(argv)
    if not a.cmd:
        p.print_help()
        return OK
    return a.fn(a) or OK


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nStopped.", file=sys.stderr)
        sys.exit(130)
